{
  "name": "dd-starter",
  "version": "1.0.0",
  "description": "Delmare Digital starter template for Payload CMS",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "pnpm build:puck-css && cross-env NODE_OPTIONS=--no-deprecation next build",
    "build:puck-css": "tailwindcss -i './src/app/(frontend)/globals.css' -o './public/puck-editor-styles.css'",
    "check": "pnpm exec tsc --noEmit && pnpm lint",
    "ci": "payload migrate && pnpm build",
    "dev": "pnpm build:puck-css && cross-env NODE_OPTIONS=--no-deprecation next dev --experimental-https",
    "dev:prod": "cross-env NODE_OPTIONS=--no-deprecation rm -rf .next && pnpm build && pnpm start",
    "dev:puck-css": "tailwindcss -i './src/app/(frontend)/globals.css' -o './public/puck-editor-styles.css' --watch",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "ii": "cross-env NODE_OPTIONS=--no-deprecation pnpm --ignore-workspace install",
    "lint": "eslint --cache --cache-location .next/cache/eslint/",
    "lint:fix": "eslint --fix",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "postbuild": "next-sitemap --config next-sitemap.config.cjs",
    "refresh-ba": "pnpm remove @delmaredigital/payload-better-auth && pnpm add @delmaredigital/payload-better-auth --registry http://localhost:4873",
    "refresh-pagetree": "pnpm remove @delmaredigital/payload-page-tree && pnpm add @delmaredigital/payload-page-tree --registry http://localhost:4873",
    "refresh-puck": "pnpm remove @delmaredigital/payload-puck && pnpm add @delmaredigital/payload-puck --registry http://localhost:4873",
    "reinstall": "cross-env NODE_OPTIONS=--no-deprecation rm -rf node_modules && rm pnpm-lock.yaml && pnpm --ignore-workspace install",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "test": "pnpm run test:int && pnpm run test:e2e",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --no-experimental-strip-types\" pnpm exec playwright test --config=playwright.config.ts",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts"
  },
  "dependencies": {
    "@better-auth/api-key": "^1.7.1",
    "@better-auth/passkey": "^1.7.1",
    "@delmaredigital/payload-better-auth": "^0.11.0",
    "@delmaredigital/payload-page-tree": "^0.3.17",
    "@delmaredigital/payload-puck": "^0.9.2",
    "@payloadcms/admin-bar": "^3.85.2",
    "@payloadcms/db-vercel-postgres": "^3.85.2",
    "@payloadcms/live-preview-react": "^3.85.2",
    "@payloadcms/next": "^3.85.2",
    "@payloadcms/plugin-redirects": "^3.85.2",
    "@payloadcms/plugin-search": "^3.85.2",
    "@payloadcms/plugin-seo": "^3.85.2",
    "@payloadcms/richtext-lexical": "^3.85.2",
    "@payloadcms/storage-vercel-blob": "^3.85.2",
    "@payloadcms/ui": "^3.85.2",
    "@puckeditor/core": "^0.23.0",
    "@radix-ui/react-checkbox": "^1.3.6",
    "@radix-ui/react-label": "^2.1.11",
    "@radix-ui/react-select": "^2.3.2",
    "@radix-ui/react-slot": "^1.3.0",
    "better-auth": "^1.7.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cross-env": "^7.0.3",
    "dotenv": "^16.6.1",
    "geist": "^1.7.2",
    "graphql": "^16.14.2",
    "lucide-react": "^0.562.0",
    "next": "^16.3.4",
    "next-sitemap": "^4.2.3",
    "payload": "^3.85.2",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.80.0",
    "sharp": "^0.35.4",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@next/eslint-plugin-next": "^16.3.4",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/postcss": "^4.3.2",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/react": "^16.3.2",
    "@types/escape-html": "^1.0.4",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.5.2",
    "copyfiles": "^2.4.1",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.3.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^26.1.0",
    "playwright": "^1.61.1",
    "playwright-core": "^1.61.1",
    "postcss": "^8.5.16",
    "prettier": "^3.9.4",
    "tailwindcss": "^4.3.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.62.1",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.6"
  },
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ],
    "overrides": {
      "@better-auth/utils": "0.5.0"
    }
  }
}
